{
	"name": "@newton-xyz/policy-pack-registry",
	"version": "0.1.0",
	"description": "Provider-owned trust data for Newton policy packs: the first-party pack-id registry and the audited policyData address map. Injected into @newton-xyz/policy-core's classifyProvenance.",
	"license": "Apache-2.0",
	"author": "Newton Protocol <https://x.com/newton_xyz> (https://newton.xyz)",
	"homepage": "https://github.com/newt-foundation/newton-policy-packs/tree/main/packages/policy-pack-registry",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/newt-foundation/newton-policy-packs.git",
		"directory": "packages/policy-pack-registry"
	},
	"bugs": {
		"url": "https://github.com/newt-foundation/newton-policy-packs/issues"
	},
	"keywords": [
		"newton",
		"newton-protocol",
		"policy-pack",
		"shield",
		"provenance",
		"registry"
	],
	"publishConfig": {
		"access": "public"
	},
	"sideEffects": false,
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		}
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"build": "tsup",
		"dev": "tsup --watch",
		"typecheck": "tsc --noEmit",
		"test": "echo 'no tests yet'"
	},
	"peerDependencies": {
		"@newton-xyz/policy-core": ">=0.2.0 <1.0.0"
	},
	"devDependencies": {
		"@newton-xyz/policy-core": "^0.2.0",
		"tsup": "^8.5.1",
		"typescript": "^5.5.0"
	}
}

{
	"name": "@newton-xyz/policy-packs",
	"version": "1.0.0",
	"description": "All Newton policy packs in one package: typed TypeScript bindings for every Newton policy pack, with one subpath export per pack.",
	"license": "Apache-2.0",
	"author": "Newton Protocol <https://x.com/newton_xyz> (https://newton.xyz)",
	"homepage": "https://github.com/newt-foundation/newton-policy-packs/tree/main/packages/policy-packs",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/newt-foundation/newton-policy-packs.git",
		"directory": "packages/policy-packs"
	},
	"bugs": {
		"url": "https://github.com/newt-foundation/newton-policy-packs/issues"
	},
	"keywords": [
		"newton",
		"newton-protocol",
		"policy-pack",
		"shield"
	],
	"publishConfig": {
		"access": "public"
	},
	"sideEffects": false,
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		},
		"./arkham_counterparty": {
			"types": "./dist/arkham_counterparty.d.ts",

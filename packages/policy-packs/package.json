			"types": "./dist/pharos_redemption.d.ts",
			"import": "./dist/pharos_redemption.js",
			"require": "./dist/pharos_redemption.cjs"
		},
		"./pharos_safe_mode": {
			"types": "./dist/pharos_safe_mode.d.ts",

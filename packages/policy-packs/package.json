			"types": "./dist/arkham_risk.d.ts",
			"import": "./dist/arkham_risk.js",
			"require": "./dist/arkham_risk.cjs"
		},
		"./balancer": {
			"types": "./dist/balancer.d.ts",
			"import": "./dist/balancer.js",
			"require": "./dist/balancer.cjs"
		},
		"./blockaid": {
			"types": "./dist/blockaid.d.ts",

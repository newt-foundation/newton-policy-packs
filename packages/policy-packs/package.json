	},
	"devDependencies": {
		"@newton-xyz/policy-pack-arkham_counterparty": "workspace:*",
		"@newton-xyz/policy-pack-arkham_entity": "workspace:*",
		"@newton-xyz/policy-pack-arkham_risk": "workspace:*",
		"@newton-xyz/policy-pack-balancer": "workspace:*",
		"@newton-xyz/policy-pack-blockaid": "workspace:*",
		"@newton-xyz/policy-pack-chainalysis": "workspace:*",
		"@newton-xyz/policy-pack-guardrail": "workspace:*",
		"@newton-xyz/policy-pack-persona": "workspace:*",
		"@newton-xyz/policy-pack-pharos_redemption": "workspace:*",
		"@newton-xyz/policy-pack-pharos_safe_mode": "workspace:*",
		"@newton-xyz/policy-pack-pharos_treasury": "workspace:*",
		"@newton-xyz/policy-pack-redstone": "workspace:*",
		"@newton-xyz/policy-pack-registry": "workspace:*",
		"@newton-xyz/policy-pack-safe_signer_threshold": "workspace:*",
		"@newton-xyz/policy-pack-sumsub": "workspace:*",
		"@newton-xyz/policy-pack-vaultsfyi": "workspace:*",
		"@newton-xyz/policy-pack-webacy": "workspace:*",
		"@newton-xyz/policy-pack-xerberus_common_cause": "workspace:*",
		"@newton-xyz/policy-pack-xerberus_liquidity_exit": "workspace:*",
		"@newton-xyz/policy-pack-xerberus_what_if": "workspace:*",
		"@newton-xyz/policy-core": "^0.2.0",
		"tsup": "^8.5.1",
		"tsx": "^4.19.0",
		"typescript": "^5.5.0",
		"viem": "^2.0.0",
		"zod": "^3.23.0"

		},
		"./xerberus_liquidity_exit": {
			"types": "./dist/xerberus_liquidity_exit.d.ts",
			"import": "./dist/xerberus_liquidity_exit.js",
			"require": "./dist/xerberus_liquidity_exit.cjs"
		},
		"./xerberus_what_if": {
			"types": "./dist/xerberus_what_if.d.ts",
			"import": "./dist/xerberus_what_if.js",
			"require": "./dist/xerberus_what_if.cjs"
		}
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"build": "tsup",
		"dev": "tsup --watch",
		"typecheck": "tsc --noEmit"
	},
	"peerDependencies": {
		"@newton-xyz/policy-core": ">=0.2.0 <1.0.0",
		"viem": "^2.0.0",

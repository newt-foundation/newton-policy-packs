			"require": "./dist/arkham_counterparty.cjs"
		},
		"./arkham_entity": {
			"types": "./dist/arkham_entity.d.ts",
			"import": "./dist/arkham_entity.js",
			"require": "./dist/arkham_entity.cjs"
